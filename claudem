#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ClaudeM — Claude Code Persistent Session Manager (No-Permission Mode)
Runs and manages persistent background Claude Code sessions in Tmux.
"""

import sys
import os
import json
import time
import shutil
import subprocess
from datetime import datetime, timedelta

def get_default_data_dir():
    # If running as root, prefer /var/lib/claudem if accessible, else ~/.local/share/claudem
    try:
        if os.geteuid() == 0:
            return "/var/lib/claudem"
    except AttributeError:
        pass
    return os.path.expanduser("~/.local/share/claudem")

DATA_DIR = os.environ.get("CLAUDEM_DATA_DIR", get_default_data_dir())
SESSIONS_FILE = os.path.join(DATA_DIR, "sessions.json")
DEFAULT_TTL_HOURS = 12

# Terminal colors
BOLD = "\033[1m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
CYAN = "\033[36m"
RED = "\033[31m"
MAGENTA = "\033[35m"
RESET = "\033[0m"
DIM = "\033[2m"

def init_env():
    try:
        os.makedirs(DATA_DIR, exist_ok=True)
    except PermissionError:
        # Fallback to home directory if /var/lib/claudem is not writable
        fallback_dir = os.path.expanduser("~/.local/share/claudem")
        os.makedirs(fallback_dir, exist_ok=True)
        globals()["DATA_DIR"] = fallback_dir
        globals()["SESSIONS_FILE"] = os.path.join(fallback_dir, "sessions.json")

    if not os.path.exists(SESSIONS_FILE):
        try:
            with open(SESSIONS_FILE, "w", encoding="utf-8") as f:
                json.dump({}, f)
        except Exception:
            pass

def load_sessions():
    init_env()
    try:
        with open(SESSIONS_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}

def save_sessions(sessions):
    init_env()
    temp_file = SESSIONS_FILE + ".tmp"
    with open(temp_file, "w", encoding="utf-8") as f:
        json.dump(sessions, f, indent=2, ensure_ascii=False)
    os.replace(temp_file, SESSIONS_FILE)

def find_claude_binary():
    candidates = [
        shutil.which("claude"),
        os.path.expanduser("~/.local/bin/claude"),
        "/usr/local/bin/claude",
        "/usr/bin/claude",
        "/root/.local/bin/claude"
    ]
    for p in candidates:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return "claude"

def trust_directory(path):
    """Mark workspace directory as trusted in Claude Code configuration to prevent trust prompts."""
    path = os.path.abspath(path)
    claude_json_paths = [
        os.path.expanduser("~/.claude.json"),
        "/root/.claude.json"
    ]
    for cjp in set(claude_json_paths):
        if not os.path.exists(cjp):
            continue
        try:
            with open(cjp, "r", encoding="utf-8") as f:
                data = json.load(f)
            projects = data.setdefault("projects", {})
            proj = projects.setdefault(path, {})
            if not proj.get("hasTrustDialogAccepted"):
                proj["hasTrustDialogAccepted"] = True
                with open(cjp, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=2)
        except Exception:
            pass

def is_tmux_session_running(name):
    res = subprocess.run(["tmux", "has-session", "-t", name],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return res.returncode == 0

def kill_tmux_session(name):
    subprocess.run(["tmux", "kill-session", "-t", name],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def format_time_remaining(seconds_left):
    if seconds_left <= 0:
        return f"{RED}Abgelaufen{RESET}"
    td = timedelta(seconds=int(seconds_left))
    days = td.days
    hours, remainder = divmod(td.seconds, 3600)
    minutes, seconds = divmod(remainder, 60)
    
    parts = []
    if days > 0:
        parts.append(f"{days}d")
    if hours > 0 or days > 0:
        parts.append(f"{hours}h")
    parts.append(f"{minutes:02d}m")
    parts.append(f"{seconds:02d}s")
    
    time_str = " ".join(parts)
    if seconds_left < 3600:
        return f"{RED}{time_str}{RESET}"
    elif seconds_left < 7200:
        return f"{YELLOW}{time_str}{RESET}"
    return f"{GREEN}{time_str}{RESET}"

def cleanup_expired_sessions(quiet=True):
    sessions = load_sessions()
    now = time.time()
    changed = False
    cleaned_ids = []

    for sid, data in list(sessions.items()):
        tmux_name = data.get("tmux_name", f"claudem-{sid}")
        expires_at = data.get("expires_at", 0)
        
        # Check if expired or dead
        is_expired = now >= expires_at
        is_alive = is_tmux_session_running(tmux_name)
        
        if is_expired or not is_alive:
            if is_alive:
                kill_tmux_session(tmux_name)
            del sessions[sid]
            changed = True
            cleaned_ids.append((sid, "abgelaufen" if is_expired else "beendet"))

    if changed:
        save_sessions(sessions)
        if not quiet and cleaned_ids:
            for sid, reason in cleaned_ids:
                print(f"{DIM}[ClaudeM Cleaner] Sitzung #{sid} ({reason}) entfernt.{RESET}")

def get_next_session_id(sessions):
    sid = 1
    while str(sid) in sessions:
        sid += 1
    return sid

